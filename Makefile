# Add your post 'test' code here...


# help
help: .help-post

.help-pre:
# Add your pre 'help' code here...

.help-post: .help-impl
# Add your post 'help' code here...


TEST_EXE=build/tests/test_suite
TEST_SRCS=tests/test_suite.c dynamic_vector.c search.c quick_sort.c big_decimal.c
TEST_CFLAGS=-O2 -std=c11 -Wall -Wextra -Werror -I.
BENCH_EXE=build/bench/benchmark
BENCH_SRCS=main.c dynamic_vector.c search.c quick_sort.c big_decimal.c

benchmark: ${BENCH_EXE}
	@echo "Ejecutando benchmark rapido..."
	@./${BENCH_EXE}

${BENCH_EXE}: ${BENCH_SRCS}
	${MKDIR} -p build/bench
	gcc ${TEST_CFLAGS} ${BENCH_SRCS} -o ${BENCH_EXE}

plot: benchmark
	@python3 plot_benchmarks.py

check: ${TEST_EXE}
	@echo "Ejecutando suite de tests..."
	@./${TEST_EXE}

${TEST_EXE}: ${TEST_SRCS}
	${MKDIR} -p build/tests
	gcc ${TEST_CFLAGS} ${TEST_SRCS} -o ${TEST_EXE}

clean-tests:
	${RM} -r build/tests
	${RM} -r build/bench



# include project implementation makefile
include nbproject/Makefile-impl.mk

# include project make variables
include nbproject/Makefile-variables.mk
